{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "flutter:debug",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=.env"
      ]
    },

    {
      "name": "flutter:release",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=.env"
      ]
    },

    {
      "name": "flutter:debug:web",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "args": [
        "--device-id=web-server",
        "--web-hostname=127.0.0.1",
        "--web-port=3000",
        "--dart-define-from-file=.env"
      ]
    },

    {
      "name": "flutter:release:web",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "args": [
        "--device-id=web-server",
        "--web-hostname=127.0.0.1",
        "--web-port=3000",
        "--dart-define-from-file=.env"
      ]
    },
  ]
}
