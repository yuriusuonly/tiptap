{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter:create",
      "type": "shell",
      "command": "flutter",
      "args": [
        "create",
        ".",
        "--org=dev.yuriusu",
        "--project-name=tiptap",
        "--description='Tap. Learn. Impress.'",
        "--platforms=android",
        "--template=app"
      ],
      "problemMatcher": []
    },

    {
      "label": "flutter:doctor",
      "type": "shell",
      "command": "flutter doctor --verbose",
      "problemMatcher": []
    },

    {
      "label": "flutter:clean",
      "type": "shell",
      "command": "flutter clean",
      "problemMatcher": []
    },

    {
      "label": "flutter:upgrade",
      "type": "shell",
      "command": "flutter upgrade",
      "problemMatcher": []
    },

    {
      "label": "flutter:pub:get",
      "type": "shell",
      "command": "flutter pub get",
      "problemMatcher": []
    },

    {
      "label": "flutter:pub:outdated",
      "type": "shell",
      "command": "flutter pub outdated",
      "problemMatcher": []
    },

    {
      "label": "flutter:pub:upgrade",
      "type": "shell",
      "command": "flutter pub upgrade",
      "problemMatcher": []
    },

    {
      "label": "flutter:build:appbundle",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "appbundle",
        "--release",
        "--dart-define-from-file=.env",
        "--target=lib/main.dart"
      ],
      "problemMatcher": []
    },

    {
      "label": "flutter:build:webapp",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "web",
        "--release",
        "--wasm",
        "--no-source-maps",
        "--dart-define-from-file=.env",
        "--target=lib/main.dart"
      ],
      "problemMatcher": []
    },

    {
      "label": "flutter:build:web",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "web",
        "--release",
        "--pwa-strategy=none",
        "--wasm",
        "--no-source-maps",
        "--dart-define-from-file=.env",
        "--target=lib/main.dart"
      ],
      "problemMatcher": []
    },

    {
      "label": "flutter:run:debug",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "--debug",
        "--dart-define-from-file=.env",
        "--target=lib/main.dart"
      ],
      "problemMatcher": []
    },

    {
      "label": "flutter:run:release",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "--release",
        "--dart-define-from-file=.env",
        "--target=lib/main.dart"
      ],
      "problemMatcher": []
    },

    {
      "label": "flutter:run:debug:web",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "--debug",
        "--device-id=web-server",
        "--web-hostname=127.0.0.1",
        "--web-port=3000",
        "--dart-define-from-file=.env",
        "--target=lib/main.dart"
      ],
      "problemMatcher": []
    },

    {
      "label": "flutter:run:release:web",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "--release",
        "--device-id=web-server",
        "--web-hostname=127.0.0.1",
        "--web-port=3000",
        "--dart-define-from-file=.env",
        "--target=lib/main.dart"
      ],
      "problemMatcher": []
    },

    {
      "label": "dart:run:rename_app",
      "type": "shell",
      "command": "dart run rename_app:main all='TipTap'",
      "problemMatcher": []
    },

    {
      "label": "dart:run:flutter_Launcher_cons",
      "type": "shell",
      "command": "dart run flutter_launcher_icons",
      "problemMatcher": []
    },

    {
      "label": "dart:run:flutter_native_splash",
      "type": "shell",
      "command": "dart run flutter_native_splash:create",
      "problemMatcher": []
    },

    {
      "label": "firebase:login",
      "type": "shell",
      "command": "firebase login",
      "problemMatcher": []
    },

    {
      "label": "firebase:initialize",
      "type": "shell",
      "command": "firebase init",
      "problemMatcher": []
    },

    {
      "label": "firebase:deploy:firestore:rules",
      "type": "shell",
      "command": "firebase",
      "args": [
        "deploy",
        "--only",
        "firestore:rules"
      ],
      "problemMatcher": []
    },

    {
      "label": "firebase:deploy:hosting",
      "type": "shell",
      "command": "firebase",
      "args": [
        "deploy",
        "--only",
        "hosting"
      ],
      "problemMatcher": []
    },

    {
      "label": "keytool:keystore",
      "type": "shell",
      "command": "keytool -genkey -v -keyalg RSA -keysize 2048 -validity 10000 -storetype JKS -alias TipTap -keystore android/app/tiptap.jks",
      "problemMatcher": []
    },

    {
      "label": "keytool:certificate",
      "type": "shell",
      "command": "keytool -export -rfc -keystore android/app/tiptap.jks -alias TipTap -file android/app/tiptap.pem",
      "problemMatcher": []
    },

    {
      "label": "android:signing_key",
      "type": "shell",
      "command": "./gradlew signingReport",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/android"
      }
    },
  ]
}
