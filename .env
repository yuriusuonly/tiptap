# App identity (single source of truth, read via src/constants/configuration.js
# and app.config.js).
EXPO_PUBLIC_APP_NAME=TipTap
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_DESCRIPTION=TipTap is an endless scroll of AI-generated short titles and text paragraphs — read something new, one card at a time.
EXPO_PUBLIC_EAS_PROJECT_ID=38a31c5d-eafb-4556-a842-c44039084b16

# App mode: "development" (real services, local; default) | "production"
# (real services, remote) | "test" (mocks served; failure states only).
EXPO_PUBLIC_APP_MODE=development

# Landing page (web) URL for the Android "About" row.
# The URL is composed as SCHEME://HOST[:PORT] in src/constants/configuration.js.
# Development builds point at the local web dev server (localhost).
EXPO_PUBLIC_LANDING_PAGE_SCHEME=http
EXPO_PUBLIC_LANDING_PAGE_HOST=localhost
EXPO_PUBLIC_LANDING_PAGE_PORT=8081

# Firebase (Android, via @react-native-firebase/* + google-services.json).
# Values mirror google-services.json (project yuriusu-tiptap, package dev.yuriusu.tiptap).
# These are public client identifiers, safe to commit in .env.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAd8NKciuLLKB5kqpa1PSfwqQdF79Ir9VI
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=yuriusu-tiptap.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=yuriusu-tiptap
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=yuriusu-tiptap.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=965554380346
EXPO_PUBLIC_FIREBASE_APP_ID=1:965554380346:android:5bfe6211cbf4c48b65df03
# Google OAuth web client ID (type 3) for Android Google Sign-In.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=965554380346-ja46nubelnoj24jeol99sqmmrmt4eb6o.apps.googleusercontent.com
