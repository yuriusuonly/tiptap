# App identity (single source of truth, read via src/shared/constants/configuration.js
# and app.config.js).
EXPO_PUBLIC_APP_NAME=TipTap
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_DESCRIPTION=TipTap is an endless scroll of AI-generated short titles and text paragraphs — read something new, one card at a time.
EXPO_PUBLIC_EAS_PROJECT_ID=38a31c5d-eafb-4556-a842-c44039084b16

# Landing page (web) URL for the Android "About" row.
# The URL is composed as SCHEME://HOST[:PORT] in src/shared/constants/configuration.js.
# Development builds point at the local web dev server (localhost).
EXPO_PUBLIC_LANDING_PAGE_SCHEME=http
EXPO_PUBLIC_LANDING_PAGE_HOST=localhost
EXPO_PUBLIC_LANDING_PAGE_PORT=8081
