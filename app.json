{
  "name": "TipTap",
  "slug": "tiptap",
  "icon": "./src/assets/images/icon.png",
  "userInterfaceStyle": "automatic",
  "android": {
    "package": "dev.yuriusu.tiptap",
    "icon": "./src/assets/images/icon.png"
  },
  "ios": {
    "bundleIdentifier": "dev.yuriusu.tiptap"
  },
  "web": {
    "bundler": "metro",
    "output": "static"
  },
  "plugins": [
    [
      "expo-build-properties",
      {
        "android": {
          "buildArchs": [
            "x86_64"
          ]
        }
      }
    ],
    [
      "expo-router",
      {
        "sitemap": false
      }
    ],
    "expo-status-bar"
  ],
  "extra": {
    "eas": {
      "projectId": "38a31c5d-eafb-4556-a842-c44039084b16"
    }
  }
}
