{
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:test": "EXPO_PUBLIC_APP_MODE=test expo start",
    "web": "expo start --web",
    "android:build": "eas build --platform android --profile development --local --output android/build/development.apk",
    "android:install": "adb install -r android/build/development.apk",
    "android:release": "eas build --platform android --profile production --auto-submit",
    "eas:download-credentials": "eas credentials:configure-build -p android -e development",
    "web:build": "expo export --platform web --output-dir web",
    "web:serve": "expo serve web",
    "firebase:initialize": "firebase init",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules",
    "firebase:deploy-hosting": "npm run web:build && mv web/+not-found.html web/404.html && firebase deploy --only hosting"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/auth": "24.0.0",
    "@react-native-firebase/firestore": "24.0.0",
    "@react-native-firebase/messaging": "24.0.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "^57.0.1",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.23",
    "expo-dev-client": "~57.0.21",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-status-bar": "~57.0.1",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "eas-cli": "^27.4.1",
    "firebase-tools": "^15.35.0",
    "react-native-svg-transformer": "^1.5.3",
    "tailwindcss": "^3.4.19"
  }
}
